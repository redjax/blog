{
    "name": "Hugo Blog Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspace",
    "remoteEnv": {
        "MISE_DIR": "/mise",
        "PATH": "/mise/bin:/mise/shims:${containerEnv:PATH}"
    },
    "postCreateCommand": "mise trust && mise install",
    "postStartCommand": "hugo server -D --bind 0.0.0.0:1313 --baseURL http://localhost:1313 --appendPort=false",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-vscode.go",
                "ms-azuretools.vscode-docker",
                "bierner.markdown-mermaid"
            ]
        }
    },
    "forwardPorts": [
        1313
    ],
    "portsAttributes": {
        "1313": {
            "label": "Hugo Dev Server"
        }
    }
}