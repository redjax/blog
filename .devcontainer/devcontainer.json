{
    "name": "Hugo Blog Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspace",
    "remoteEnv": {
        "PATH": "/root/.local/bin:/root/.local/share/mise/shims:${containerEnv:PATH}"
    },
    "postCreateCommand": "/root/.local/bin/mise trust && /root/.local/bin/mise install && /root/.local/bin/mise shims",
    "postStartCommand": "hugo server -D --bind 0.0.0.0:1313 --baseURL http://localhost:1313",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-vscode.go",
                "ms-azuretools.vscode-docker",
                "bierner.markdown-mermaid"
            ]
        }
    },
    "forwardPorts": [
        1313
    ]
}